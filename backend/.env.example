# ─────────────────────────────────────────────────────────────
# backend/.env.example  —  copy to backend/.env and fill values
# backend/.env is gitignored and never committed.
# In production (K8s) these are injected from the parsehub-secrets secret.
# ─────────────────────────────────────────────────────────────

# ParseHub API key — get it from parsehub.com > Account > API
PARSEHUB_API_KEY=your_parsehub_api_key_here

PARSEHUB_BASE_URL=https://www.parsehub.com/api/v2

# Internal auth key shared between frontend and backend.
# Any random strong string works — must match frontend BACKEND_API_KEY.
BACKEND_API_KEY=your_backend_api_key_here

# Optional dedicated key for internal automation routes (X-Internal-Automation-Key)
AUTOMATION_INTERNAL_KEY=your_automation_internal_key_here

# Optional shared secret for ParseHub webhook endpoint auth
PARSEHUB_WEBHOOK_SECRET=your_parsehub_webhook_secret_here

# Flask port
BACKEND_PORT=5001
PORT=5001

# How often (minutes) to check for incomplete projects
INCREMENTAL_SCRAPING_INTERVAL=30

# How often (minutes) to auto-sync data from ParseHub API
AUTO_SYNC_INTERVAL=5

# ─────────────────────────────────────────────────────────────
# Snowflake connection (required)
# In production (K8s) these come from the snowflake-credentials secret.
# ─────────────────────────────────────────────────────────────
SNOWFLAKE_ACCOUNT=your_snowflake_account
SNOWFLAKE_USER=your_snowflake_user
SNOWFLAKE_PASSWORD=your_snowflake_password
SNOWFLAKE_WAREHOUSE=your_snowflake_warehouse
SNOWFLAKE_DATABASE=your_snowflake_database
SNOWFLAKE_SCHEMA=your_snowflake_schema

# If true, first connection runs CREATE WAREHOUSE / DATABASE / SCHEMA IF NOT EXISTS (needs privileges).
# Set false if your admin creates these in the Snowflake UI.
SNOWFLAKE_AUTO_PROVISION=false

# When true, SnowflakeDatabase.init_db runs create_all_tables() (CREATE IF NOT EXISTS + project column patches).
# Set false in production after tables are provisioned (saves warehouse work on every worker boot).
# Set true once on a new database, or apply DDL in Snowflake.
SNOWFLAKE_BOOTSTRAP_DDL=false

# Snowflake performance tuning
SNOWFLAKE_CONNECTION_POOL_SIZE=10
SNOWFLAKE_QUERY_TIMEOUT=300
# ParseHub API resilience and throttling (safe defaults shown)
PARSEHUB_SUSTAINED_RPS=2
PARSEHUB_BURST_RPS=5
PARSEHUB_MAX_INFLIGHT=4
PARSEHUB_RETRY_MAX_ATTEMPTS=4
PARSEHUB_RETRY_BACKOFF_SECONDS=0.5
PARSEHUB_TIMEOUT_SECONDS=30

# Automation scheduler controls
AUTOMATION_ENABLED=1
AUTOMATION_SCHEDULER_ENABLED=1
AUTOMATION_MAX_WORKERS=4
AUTOMATION_STATUS_WORKERS=4
AUTOMATION_INGEST_WORKERS=3
AUTOMATION_RESUME_WORKERS=2
AUTOMATION_RECONCILE_LIMIT=40
AUTOMATION_SYNC_MSA_MINUTES=5
AUTOMATION_RECONCILE_SECONDS=60

# CRITICAL SAFETY GATE — Auto-Resume Pagination
# When 1: after each page run completes, the system will automatically start
# the next page run WITHOUT any user action (paginated scrape chain).
# When 0 (default): projects only run when user explicitly clicks Run/Resume
# or a valid scheduled entry fires.  Set to 1 only if you intentionally want
# fully automated paginated scraping.
AUTOMATION_RESUME_ENABLED=0

# Scheduled run controls
SCHEDULED_RUN_MAX_RETRIES=0
SCHEDULED_RUN_RETRY_DELAY_SECONDS=60
SCHEDULED_RUN_STALE_TRIGGER_SECONDS=180
SCHEDULED_RUN_CLAIM_LIMIT=25
SCHEDULE_POLL_SECONDS=10
