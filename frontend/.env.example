# ─────────────────────────────────────────────────────────────
# frontend/.env.example  —  copy to frontend/.env and fill values
# frontend/.env is gitignored and never committed.
# In production (K8s) these are injected from K8s secrets / frontend-config.
# ─────────────────────────────────────────────────────────────

# URL of the backend as seen by Next.js server-side route handlers
# Local dev: http://localhost:5000
# Docker Compose: http://backend:5000
NEXT_PUBLIC_BACKEND_URL=http://localhost:5001

# Public base URL of this Next.js app
NEXT_PUBLIC_API_URL=http://localhost:3000

# Internal backend URL used by server-side route handlers
# (same as NEXT_PUBLIC_BACKEND_URL for local dev)
BACKEND_URL=http://localhost:5001

# Auth key to call the backend API — must match BACKEND_API_KEY in backend/.env
BACKEND_API_KEY=your_backend_api_key_here

PORT=3000

# Heartbeat safety gate for scheduled runs polling in the UI
NEXT_PUBLIC_HEARTBEAT_ENABLED=true
